<div class="thehub-dashboard">

  <!-- Sidebar -->
  <aside class="thehub-sidebar">

    <div class="thehub-logo">
      <div class="thehub-logo-mark">TH</div>
      <span>TheHub</span>
    </div>

    <nav class="thehub-nav">

      <%= link_to events_path, class: "nav-item active" do %>
        <span class="nav-icon">⌂</span>
        <span>Events</span>
      <% end %>

      <%= link_to new_event_path, class: "nav-item" do %>
        <span class="nav-icon">＋</span>
        <span>Create Event</span>
      <% end %>

    </nav>

    <div class="sidebar-bottom">
      <div class="sidebar-user">
        <div class="user-avatar">
          <%= current_user.name.first.upcase %>
        </div>

        <div class="user-info">
          <strong><%= current_user.name %></strong>
          <small>Member</small>
        </div>
      </div>

      <%= link_to "Sign out", logout_path,
          method: :delete,
          class: "logout-link" %>
    </div>

  </aside>


  <!-- Main content -->
  <main class="thehub-main">

    <!-- Top bar -->
    <header class="thehub-topbar">

      <div>
        <p class="topbar-label">THEHUB COMMUNITY</p>
        <h1>Events</h1>
      </div>

      <div class="topbar-actions">

        <div class="notification">
          🔔
        </div>

        <div class="top-user">
          <div class="top-avatar">
            <%= current_user.name.first.upcase %>
          </div>

          <div>
            <strong><%= current_user.name %></strong>
            <small>Member</small>
          </div>
        </div>

      </div>

    </header>


    <!-- Welcome section -->
    <section class="welcome-section">

      <div>
        <h2>
          Welcome back, <%= current_user.name.split.first %> 👋
        </h2>

        <p>
          Discover what's happening around TheHub.
        </p>
      </div>

      <%= link_to new_event_path, class: "create-event-button" do %>
        <span>＋</span>
        Create Event
      <% end %>

    </section>


    <!-- Statistics -->
    <section class="event-statistics">

      <div class="stat-card">
        <div class="stat-icon blue">📅</div>

        <div>
          <span>Total Events</span>
          <strong><%= @events.count %></strong>
        </div>
      </div>


      <div class="stat-card">
        <div class="stat-icon green">🗓</div>

        <div>
          <span>Upcoming</span>
          <strong>
            <%= @events.count { |event| event.date >= Time.current } %>
          </strong>
        </div>
      </div>


      <div class="stat-card">
        <div class="stat-icon purple">👥</div>

        <div>
          <span>Community</span>
          <strong>Active</strong>
        </div>
      </div>

    </section>


    <!-- Events heading -->
    <div class="events-heading">

      <div>
        <h2>Upcoming Events</h2>
        <p>Stay updated with what's happening.</p>
      </div>

      <span class="event-count">
        <%= @events.count %> events
      </span>

    </div>


    <!-- Event cards -->
    <% if @events.any? %>

      <section class="events-grid">

        <% @events.each do |event| %>

          <article class="modern-event-card">

            <div class="event-image-placeholder">

              <div class="event-image-icon">
                📅
              </div>

              <span class="event-badge">
                EVENT
              </span>

            </div>


            <div class="event-card-content">

              <div class="event-date">
                <span class="calendar-day">
                  <%= event.date.strftime("%d") %>
                </span>

                <span>
                  <%= event.date.strftime("%B %Y") %>
                </span>
              </div>


              <h3>
                <%= link_to event.name, event %>
              </h3>


              <p class="event-description">
                <%= truncate(event.description.to_s, length: 110) %>
              </p>


              <div class="event-details">

                <div>
                  <span>📍</span>
                  <%= event.location %>
                </div>

                <div>
                  <span>🕐</span>
                  <%= event.date.strftime("%l:%M %p") %>
                </div>

              </div>


              <div class="event-footer">

                <div class="organizer">

                  <div class="organizer-avatar">
                    <%= event.organizer.name.first.upcase %>
                  </div>

                  <div>
                    <small>Organized by</small>
                    <strong>
                      <%= event.organizer.name %>
                    </strong>
                  </div>

                </div>


                <%= link_to event, class: "view-event" do %>
                  View →
                <% end %>

              </div>

            </div>

          </article>

        <% end %>

      </section>

    <% else %>

      <section class="empty-events">

        <div class="empty-icon">
          📅
        </div>

        <h3>No events yet</h3>

        <p>
          Be the first person to create an event for the community.
        </p>

        <%= link_to "Create the first event", new_event_path,
            class: "create-event-button" %>

      </section>

    <% end %>

  </main>

</div>